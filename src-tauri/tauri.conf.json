{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Converter",
  "version": "0.1.1",
  "identifier": "com.squ1ggly.converter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm ui:dev",
    "beforeBuildCommand": "pnpm ui:build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi",
      "deb",
      "rpm"
    ],
    "externalBin": [
      "binaries/converter-ffmpeg"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../licenses/FFmpeg/COPYING.GPLv3": "licenses/FFmpeg/COPYING.GPLv3",
      "../licenses/FFmpeg/LICENSE.md": "licenses/FFmpeg/LICENSE.md"
    },
    "publisher": "Squ1ggly",
    "homepage": "https://github.com/Squ1ggly/converter-desktop",
    "category": "Utility",
    "shortDescription": "Convert images and videos",
    "longDescription": "Convert images and videos between formats on your own computer. Nothing is uploaded.",
    "license": "MIT AND GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright © 2026 Squ1ggly",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "wix": {
        "upgradeCode": "4a4c23da-9be9-431a-9586-7c5b42be283f"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "section": "graphics"
      }
    }
  }
}
